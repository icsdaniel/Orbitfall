[configuration]
entry_symbol = "orbitfall_library_init"
compatibility_minimum = "4.5"
reloadable = true

[libraries]
linux.debug.x86_64 = "res://bin/liborbitfall.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/liborbitfall.linux.template_release.x86_64.so"
windows.debug.x86_64 = "res://bin/liborbitfall.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/liborbitfall.windows.template_release.x86_64.dll"
macos.debug = "res://bin/liborbitfall.macos.template_debug.universal.dylib"
macos.release = "res://bin/liborbitfall.macos.template_release.universal.dylib"
android.debug.arm64 = "res://bin/liborbitfall.android.template_debug.arm64.so"
android.release.arm64 = "res://bin/liborbitfall.android.template_release.arm64.so"
web.debug.wasm32 = "res://bin/liborbitfall.web.template_debug.wasm32.nothreads.wasm"
web.release.wasm32 = "res://bin/liborbitfall.web.template_release.wasm32.nothreads.wasm"
