#!/usr/bin/env python
# Builds the Orbitfall GDExtension: godot-cpp + core/ sources + binding in src/.
import os
# GODOT_CPP_PATH lets worktrees share one prebuilt godot-cpp checkout.
godot_cpp = os.environ.get("GODOT_CPP_PATH", "godot-cpp")
# Web builds are always no-threads (BRIEF §5.8): matches the web_dlink_nothreads export
# template and the .nothreads names in bin/orbitfall.gdextension.
if ARGUMENTS.get("platform") == "web":
    ARGUMENTS.setdefault("threads", "no")
env = SConscript(os.path.join(godot_cpp, "SConstruct"))
env.Append(CPPPATH=["src/", "../core/"])
core_dirs = ["sim", "pools", "systems", "spatial", "content"]
sources = Glob("src/*.cpp")
for d in core_dirs:
    for root, _, files in os.walk(os.path.join("..", "core", d)):
        for f in files:
            if f.endswith(".cpp"):
                sources.append(File(os.path.join(root, f)))
if env["platform"] == "web":
    env.Append(CPPDEFINES=["ORBITFALL_SINGLE_THREADED"])
suffix = env["suffix"]  # e.g. .linux.template_debug.x86_64
lib = env.SharedLibrary("../bin/liborbitfall{}{}".format(suffix, env["SHLIBSUFFIX"]), source=sources)
Default(lib)
